## Push 1: add and view books

**library.py**
```python
class Library:
    def __init__(self):
        self.books = []
        self.next_id = 1

    def add_book(self, title, author):
        title = (title or "").strip()
        author = (author or "").strip()
        if not title or not author:
            raise ValueError("Title and author are required.")

        book = {"id": self.next_id, "title": title, "author": author, "available": True}
        self.books.append(book)
        self.next_id += 1
        return book

    def available_books(self):
        return [book for book in self.books if book["available"]]
```

**app.py**
```python
import os

from flask import Flask, flash, redirect, render_template, request, url_for

from library import Library


def create_app():
    app = Flask(__name__)
    app.secret_key = os.getenv("SECRET_KEY", "library-secret-key")
    library = Library()

    @app.context_processor
    def inject_version():
        return {"version": os.getenv("APP_VERSION", "dev")}

    @app.route("/")
    def home():
        return render_template("index.html")

    @app.route("/add", methods=["GET", "POST"])
    def add_book():
        if request.method == "POST":
            try:
                book = library.add_book(request.form.get("title"), request.form.get("author"))
                flash(f"Book '{book['title']}' added with ID {book['id']}.", "success")
                return redirect(url_for("view_books"))
            except ValueError as error:
                flash(str(error), "error")

        return render_template("add.html")

    @app.route("/books")
    def view_books():
        return render_template("books.html", books=library.available_books())

    @app.route("/health")
    def health():
        return {"status": "ok", "version": os.getenv("APP_VERSION", "dev")}

    return app


app = create_app()


if __name__ == "__main__":
    app.run(host="0.0.0.0", port=int(os.getenv("PORT", "5000")))
```

