**.github/workflows/ci-cd.yml**
```yaml
name: Library Book Management CI/CD

on:
  push:
    branches:
      - main

env:
  IMAGE_NAME: ${{ vars.DOCKERHUB_USERNAME }}/library-book-app

jobs:
  continuous-integration:
    name: Continuous Integration
    runs-on: ubuntu-latest
    steps:
      - name: Check out code
        uses: actions/checkout@v5

      - name: Set up Python
        uses: actions/setup-python@v6
        with:
          python-version: "3.12"
          cache: pip

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt

      - name: Run automated tests
        run: pytest -v

  build:
    name: Build and Push Docker Image
    runs-on: ubuntu-latest
    needs: continuous-integration
    outputs:
      image: ${{ steps.tag.outputs.image }}
    steps:
      - name: Check out code
        uses: actions/checkout@v5

      - name: Generate unique image tag
        id: tag
        run: |
          TAG="v${{ github.run_number }}-${GITHUB_SHA::7}"
          echo "tag=$TAG" >> "$GITHUB_OUTPUT"
          echo "image=$IMAGE_NAME:$TAG" >> "$GITHUB_OUTPUT"
          echo "Image for this push: $IMAGE_NAME:$TAG"

      - name: Log in to Docker Hub
        uses: docker/login-action@v3
        with:
          username: ${{ vars.DOCKERHUB_USERNAME }}
          password: ${{ secrets.DOCKERHUB_TOKEN }}

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Build and push Docker image
        uses: docker/build-push-action@v6
        with:
          context: .
          push: true
          tags: ${{ steps.tag.outputs.image }}
          build-args: |
            APP_VERSION=${{ steps.tag.outputs.tag }}

  deploy:
    name: Deploy to Kubernetes
    runs-on: ubuntu-latest
    needs: build
    steps:
      - name: Check out code
        uses: actions/checkout@v5

      - name: Create Kubernetes cluster
        uses: helm/kind-action@v1
        with:
          cluster_name: library-cluster

      - name: Use the image built from this push
        run: sed -i "s|IMAGE_PLACEHOLDER|${{ needs.build.outputs.image }}|" k8s/deployment.yaml

      - name: Deploy application and service
        run: |
          kubectl apply -f k8s/deployment.yaml
          kubectl apply -f k8s/service.yaml
          kubectl rollout status deployment/library-book-app --timeout=180s

      - name: Verify deployment
        run: |
          kubectl get deployments -o wide
          kubectl get pods -o wide
          kubectl get services
          DEPLOYED_IMAGE=$(kubectl get deployment library-book-app -o jsonpath='{.spec.template.spec.containers[0].image}')
          echo "Deployed image: $DEPLOYED_IMAGE"
          test "$DEPLOYED_IMAGE" = "${{ needs.build.outputs.image }}"

      - name: Access application through the service
        run: |
          kubectl port-forward service/library-book-service 8080:80 > /dev/null 2>&1 &
          sleep 5
          curl -s http://localhost:8080/health
          echo
          curl -s http://localhost:8080/ | grep "Version:"
```

## One-time setup before Push 1

1. On Docker Hub, go to Account settings, then Personal access tokens, and create a token with **Read & Write** access.
2. On GitHub, create an empty repo named `library-book-app`. Don't add a README.
3. In the repo, go to Settings, then Secrets and variables, then Actions:
   - On the **Variables** tab, add `DOCKERHUB_USERNAME` set to your Docker Hub username. It's a variable, not a secret, so the image name shows in the logs instead of `***`.
   - On the **Secrets** tab, add `DOCKERHUB_TOKEN` set to the token from step 1.

