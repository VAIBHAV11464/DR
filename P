**library.py**
```python
class Library:
    def __init__(self):
        self.books = []
        self.next_id = 1

    def add_book(self, title, author):
        title = (title or "").strip()
        author = (author or "").strip()
        if not title or not author:
            raise ValueError("Title and author are required.")

        book = {"id": self.next_id, "title": title, "author": author, "available": True}
        self.books.append(book)
        self.next_id += 1
        return book

    def available_books(self):
        return [book for book in self.books if book["available"]]

    def issued_books(self):
        return [book for book in self.books if not book["available"]]

    def issue_book(self, book_id, member):
        try:
            book_id = int(book_id)
        except (TypeError, ValueError):
            raise ValueError("Invalid book ID.") from None

        member = (member or "").strip()
        if not member:
            raise ValueError("Member name is required.")

        for book in self.books:
            if book["id"] == book_id:
                if not book["available"]:
                    raise ValueError(f"Book '{book['title']}' is already issued.")
                book["available"] = False
                book["issued_to"] = member
                return book

        raise ValueError(f"Book with ID {book_id} not found.")
